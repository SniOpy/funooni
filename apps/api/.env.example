PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase (source de vérité des inscriptions)
# URL du projet + clé service_role (serveur uniquement, jamais dans le navigateur)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (confirmation visiteur + notification admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application
# L'expéditeur affiché aux visiteurs est toujours "Tadara" (voir mailer.js).
# Destinataire des inscriptions (toi). Si vide, SMTP_USER est utilisé.
ADMIN_EMAIL=

# Mot de passe du dashboard /admin (serveur uniquement)
ADMIN_DASHBOARD_PASSWORD=
