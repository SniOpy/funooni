PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=

# SMTP (obligatoire pour envoyer l'email HTML de confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application
# L'expéditeur affiché aux visiteurs est toujours "Tadara" (voir mailer.js).
# Secret pour réinitialiser les inscriptions en prod : POST /api/leads-reset
LEADS_RESET_SECRET=
# Destinataire des inscriptions (toi). Si vide, SMTP_USER est utilisé.
ADMIN_EMAIL=
